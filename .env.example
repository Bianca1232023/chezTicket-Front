# URL pública da API consumida pelo frontend.
# Em desenvolvimento, mantenha /api para usar o proxy do Vite.
VITE_API_BASE_URL=/api

# Destino do proxy local do Vite (backend Spring Boot).
VITE_API_PROXY_TARGET=http://localhost:8081

# Google Maps Embed API key, required for the interactive address preview.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
